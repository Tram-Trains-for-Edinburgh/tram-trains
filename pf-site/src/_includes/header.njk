<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/assets/images/logo-ttfe.webp" alt="{{ site.title }}" class="logo-img">
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="hamburger"></span>
    </button>
    <nav class="nav-links">
      {%- for item in site.nav %}
      {%- if item.external %}
      <a href="{{ item.url }}" class="nav-link nav-link--pill" target="_blank" rel="noopener">{{ item.text }} <span class="nav-external" aria-hidden="true">↗</span></a>
      {%- else %}
      <a href="{{ item.url }}" class="nav-link{% if page.url == item.url %} nav-active{% endif %}">{{ item.text }}</a>
      {%- endif %}
      {%- endfor %}
    </nav>
  </div>
</header>
